{
  "appId": "com.nodecraft.workflowstudio",
  "appName": "ComfyUI Studio",
  "webDir": "dist",
  "backgroundColor": "#090b0e",
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "ios": {
    "backgroundColor": "#090b0e",
    "contentInset": "never",
    "webContentsDebuggingEnabled": false
  },
  "android": {
    "backgroundColor": "#090b0e",
    "allowMixedContent": false
  }
}
